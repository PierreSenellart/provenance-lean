module

public import Provenance.Conformance.ExpectedAnn
public import Provenance.Conformance.Basic
public import Provenance.Semirings.Nat
public import Provenance.Semirings.Bool
import all Provenance.AggQuery
import all Provenance.Derived

/-!
# Conformance of the annotated semantics with ProvSQL: shared notation

The modules `Provenance.Conformance.Ann.F0` to `F9` take the queries of the
plain conformance suite, with the terms written there, and state that the
annotated semantics gives on every instance the annotations ProvSQL gave,
which `Provenance.Conformance.ExpectedAnn` records: over the counting
semiring, the rows weighted by `weightN`, and over the Boolean semiring,
under each valuation `valB j`. Rows annotated zero are left out on both
sides, and so are the values of aggregate columns (`regOf`), which the plain
suite checks.

Each instance and valuation has a theorem of its own, which `decide +kernel`
proves once the casts of the derived operators are rewritten away
(`AggQueryIn.evaluate_castKind`, `addCases_const` …); the statement over every
instance gathers them. The modules and their proofs are generated by
`scripts/conformance_ann_lean.py`, and are not edited by hand.

What the proofs need beyond unfolding is here:

* `pairCol_k`, deciding `AggTok.Joint` in the kernel, for the expressions over
  two aggregate columns;
* `gammaSet_enum`, a grouping set as a grouping over an enumeration of the set
  given explicitly, where the library's enumeration (`Finset.orderIsoOfFin`)
  does not compute;
* decidable equality of annotated tuples and relations, for the fixpoint of a
  set recursion.
-/

@[expose] public section

namespace Conformance

open WithNull

scoped instance : HasAltLinearOrder ℕ := ⟨inferInstance⟩
scoped instance : HasAltLinearOrder Bool := ⟨inferInstance⟩

/-- A relation of the instance, row `k` of the table at position `p`
annotated `f p k`. -/
abbrev annRel {K : Type} (f : ℕ → ℕ → K) {n : ℕ} (p : ℕ) (l : List (Tuple V n)) :
    AnnotatedRelation V K n :=
  ((l.zipIdx.map (fun x => (toLex (x.1, f p x.2) : AnnotatedTuple V K n))
    : List (AnnotatedTuple V K n)) : Multiset _)

/-- The annotated database of an instance, the tables at the positions of the
schema of `conformance/instances.sql`. -/
abbrev annDb {K : Type} (f : ℕ → ℕ → K) (i : Inst) : AnnotatedDatabase V K :=
  [("dept", ⟨2, annRel f 0 (deptRows i)⟩), ("emp", ⟨3, annRel f 1 (empRows i)⟩),
   ("t", ⟨1, annRel f 2 (tRows i)⟩), ("s", ⟨1, annRel f 3 (sRows i)⟩),
   ("u", ⟨1, annRel f 4 (uRows i)⟩), ("edge", ⟨2, annRel f 5 (edgeRows i)⟩),
   ("cyc", ⟨2, annRel f 6 (cycRows i)⟩)]

/-- The regular value of a column, the null for an aggregate one. -/
abbrev regOf {K : Type} (x : GenValue V K) : V := Sum.elim id (fun _ => nil) x

/-- The annotated answer of a query over the counting semiring, rows annotated
zero left out. -/
noncomputable abbrev runNR (i : Inst) {n : ℕ} {κ : Fin n → ColKind} (q : AggQuery V n κ) :
    Multiset (Tuple V n × ℕ) :=
  ((q.evaluate (annDb weightN i)).map
    (fun r => ((fun k => regOf (r.1 k)), r.2.finalize))).filter (fun p => p.2 ≠ 0)

/-- The annotated answer of a query over the Boolean semiring under the
valuation `j`, rows annotated false left out. -/
noncomputable abbrev runBR (j : Val) (i : Inst) {n : ℕ} {κ : Fin n → ColKind}
    (q : AggQuery V n κ) : Multiset (Tuple V n × Bool) :=
  ((q.evaluate (annDb (valB j) i)).map
    (fun r => ((fun k => regOf (r.1 k)), r.2.finalize))).filter (fun p => p.2 ≠ 0)

/-- `Fin.addCases` into a non-dependent type, without its casts. -/
theorem addCases_const {m n : ℕ} {α : Sort _} (f : Fin m → α) (g : Fin n → α)
    (j : Fin (m + n)) :
    Fin.addCases (motive := fun _ => α) f g j
      = if h : (j : ℕ) < m then f ⟨j, h⟩ else g ⟨j - m, by omega⟩ := by
  unfold Fin.addCases
  split <;> simp [Fin.castLT, Fin.subNat]

/-- `Fin.snoc` into a non-dependent type, without its casts. -/
theorem snoc_const {n : ℕ} {α : Sort _} (p : Fin n → α) (x : α) (i : Fin (n + 1)) :
    Fin.snoc (α := fun _ => α) p x i = if h : (i : ℕ) < n then p ⟨i, h⟩ else x := by
  unfold Fin.snoc
  split <;> simp [Fin.castLT]

/-- `Fin.append`, without its casts. -/
theorem append_const {m n : ℕ} {α : Sort _} (u : Fin m → α) (v : Fin n → α) :
    Fin.append u v = fun j : Fin (m + n) =>
      if h : (j : ℕ) < m then u ⟨j, h⟩ else v ⟨j - m, by omega⟩ := by
  funext j
  exact addCases_const u v j

/-- `AggTok.Joint`, decided by the kernel. -/
instance jointDecK {K : Type} [CommSemiringWithMonus K] [DecidableEq K] [HasAltLinearOrder K]
    (x y : AggTok V K) : Decidable (AggTok.Joint x y) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _))

/-- `AggTok.pairCol` with the kernel's decision of `AggTok.Joint` (the
library's is classical). -/
theorem pairCol_k {K : Type} [CommSemiringWithMonus K] [DecidableEq K] [HasAltLinearOrder K]
    (t : TermIn V 2 0) (x y : AggTok V K) :
    x.pairCol t y = @ite _ (AggTok.Joint x y) (jointDecK x y) (x.pairTerm t y)
      (.constTok (t.binary x.collapse y.collapse) (.pair t x.fam y.fam [])) := by
  unfold AggTok.pairCol
  congr

/-- The columns of a projection written out, evaluated one by one. -/
theorem eval_vecCons {K : Type} [CommSemiringWithMonus K] [DecidableEq K] [HasAltLinearOrder K]
    {c n m : ℕ} {κ : Fin n → ColKind} (p : ProjColIn V c κ) (ps : Fin m → ProjColIn V c κ)
    (u : Tuple (GenValue V K) n) :
    (fun j : Fin (m + 1) => (Matrix.vecCons p ps j).eval u) =
      Matrix.vecCons (p.eval u) (fun j => (ps j).eval u) := by
  funext j
  refine Fin.cases rfl (fun _ => rfl) j

/-- Equality of annotated tuples, decided as that of pairs. -/
instance lexDecEq {T : Type} [DecidableEq T] {n : ℕ} {K : Type} [DecidableEq K] :
    DecidableEq (Tuple T n ×ₗ K) :=
  inferInstanceAs (DecidableEq (Tuple T n × K))

/-- Equality of annotated relations, decided as that of multisets of pairs. -/
instance relDecEq {T : Type} [DecidableEq T] {n : ℕ} {K : Type} [DecidableEq K] :
    DecidableEq (AnnotatedRelation T K n) :=
  inferInstanceAs (DecidableEq (Multiset (Tuple T n × K)))


/-- A grouping set's padding, the set given by the position `pos` of each
key column in it. -/
def gsColPos {c m r na : ℕ} (pos : Fin m → Option (Fin r)) (j : Fin (m + na)) :
    ProjColIn V c (Fin.append (fun _ : Fin r => ColKind.reg) (fun _ : Fin na => ColKind.agg)) :=
  Fin.addCases
    (fun a : Fin m => match pos a with
      | some x => .term (TermGIn.index (Fin.castAdd na x) (Fin.append_left _ _ _))
      | none => .term (TermGIn.const ValueTypeNull.null))
    (fun l : Fin na => .token (Fin.natAdd r l) (Fin.append_right _ _ l))
    j

/-- The kinds of `gsColPos`: the key columns are regular, the aggregates
tokens. -/
theorem gsColPos_kind {c m r na : ℕ} (pos : Fin m → Option (Fin r)) (j : Fin (m + na)) :
    (gsColPos (c := c) (na := na) pos j).kind
      = Fin.append (fun _ : Fin m => ColKind.reg) (fun _ : Fin na => ColKind.agg) j := by
  refine Fin.addCases (fun a => ?_) (fun l => ?_) j
  · rw [gsColPos, Fin.addCases_left, Fin.append_left]
    split <;> rfl
  · rw [gsColPos, Fin.addCases_right, Fin.append_right]
    rfl

/-- **A non-empty grouping set, its enumeration given**: the aggregation on
the columns `e` lists, increasingly, padded by the positions `pos`. -/
theorem gammaSet_enum {c k m na : ℕ} (is : Tuple (Fin k) m)
    (ts : Tuple (TermIn V c k) na) (fs : Tuple (SeqAggFunc V) na)
    (S : Finset (Fin m)) (hS : S ≠ ∅)
    (e : Fin S.card → Fin m) (he : StrictMono e) (hmem : ∀ x, e x ∈ S)
    (pos : Fin m → Option (Fin S.card)) (hpos : ∀ x, pos (e x) = some x)
    (hout : ∀ a, a ∉ S → pos a = none)
    (q : AggQueryIn V c k (ColKind.allReg k)) :
    AggQueryIn.gammaSet is ts fs S q
      = (AggQueryIn.Proj (gsColPos pos)
          (AggQueryIn.Gamma (lab := 0) (rd := fun _ => false) (fun x => is (e x)) ts fs q)).castKind
          (funext (gsColPos_kind pos)) := by
  have he' : e = S.orderEmbOfFin rfl := Finset.orderEmbOfFin_unique rfl hmem he
  have hiso : ∀ x, ((S.orderIsoOfFin rfl) x : Fin m) = e x := fun x => by
    rw [he']; rfl
  have hkey : (fun x => is ((S.orderIsoOfFin rfl) x)) = fun x => is (e x) :=
    funext fun x => congrArg is (hiso x)
  have hcol : AggQueryIn.gsCol (T := V) (c := c) S na = gsColPos pos := by
    funext j
    refine Fin.addCases (fun a => ?_) (fun l => ?_) j
    · rw [AggQueryIn.gsCol, Fin.addCases_left, gsColPos, Fin.addCases_left]
      by_cases ha : a ∈ S
      · have hea : e (AggQueryIn.gsPos S a ha) = a := by
          rw [← hiso]
          show ((S.orderIsoOfFin rfl) ((S.orderIsoOfFin rfl).symm ⟨a, ha⟩) : Fin m) = a
          rw [OrderIso.apply_symm_apply]
        have hp : pos a = some (AggQueryIn.gsPos S a ha) := by
          have := hpos (AggQueryIn.gsPos S a ha)
          rwa [hea] at this
        simp only [ha, ↓reduceDIte, hp]
      · simp only [ha, ↓reduceDIte, hout a ha]
    · rw [AggQueryIn.gsCol, Fin.addCases_right, gsColPos, Fin.addCases_right]
  rw [AggQueryIn.gammaSet, ite_eq_right hS, hkey]
  have gen : ∀ (cols : Tuple (ProjColIn V c _) (m + na)) (hc : cols = gsColPos pos)
      (h : (fun j => (cols j).kind)
        = Fin.append (fun _ : Fin m => ColKind.reg) (fun _ : Fin na => ColKind.agg)),
      (AggQueryIn.Proj cols (AggQueryIn.Gamma (lab := 0) (rd := fun _ => false)
          (fun x => is (e x)) ts fs q)).castKind h
        = (AggQueryIn.Proj (gsColPos pos) (AggQueryIn.Gamma (lab := 0) (rd := fun _ => false)
          (fun x => is (e x)) ts fs q)).castKind (funext (gsColPos_kind pos)) := by
    intro cols hc h
    subst hc
    rfl
  exact gen _ hcol _

end Conformance
