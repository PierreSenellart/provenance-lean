/-- **The generating sets of the recursion-free algebra in the minimal
universe**, among the classes with no recursion, over `ℕ` with the
counting aggregate: exactly the supersets of one of the four bases – `∅`,
`Π`, `⊎`, `γ`, `win`, with `σ` or `−` and with `×` or the apply, every
pairing. With recursion `{−, ×}` is not one (`not_generatesOnRec_prodDiff`):
`σ` or the apply is what a recursive term needs to drop a row. -/
theorem generatesOnRF_iff {S : Set OpKind} (hmb : OpKind.muBag ∉ S)
    (hms : OpKind.muSet ∉ S) :
    (∀ sch : Schema, GeneratesOnRF ℕ sch SeqAggFunc.count S)
      ↔ rfSelApplyOps ⊆ S ∨ rfSelProdOps ⊆ S ∨ rfDiffApplyOps ⊆ S ∨ rfDiffProdOps ⊆ S := by
  constructor
  · intro hgen
    obtain ⟨he, hp, hu, hg, hw, hs, ha⟩ := required_mem_of_generatesOnRF hmb hms hgen
    have hsub : ∀ {B : Set OpKind} {x y : OpKind},
        B = {OpKind.empty, OpKind.proj, x, y, OpKind.union, OpKind.gamma, OpKind.win} →
        x ∈ S → y ∈ S → B ⊆ S := by
      intro B x y hB hx hy k hk
      rw [hB] at hk
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> assumption
    rcases hs with hs | hs <;> rcases ha with ha | ha
    · exact Or.inr (Or.inl (hsub rfl hs ha))
    · exact Or.inl (hsub rfl hs ha)
    · exact Or.inr (Or.inr (Or.inr (hsub rfl hs ha)))
    · exact Or.inr (Or.inr (Or.inl (hsub rfl hs ha)))
  · rintro (h | h | h | h) sch
    · exact GeneratesOnRF.mono h
        (rfSelApplyOps_generatesOnRF sch _ SeqAggFunc.isCount_count_nat)
    · exact GeneratesOnRF.mono h
        (rfSelProdOps_generatesOnRF sch _ SeqAggFunc.isCount_count_nat)
    · exact GeneratesOnRF.mono h
        (rfDiffApplyOps_generatesOnRF sch _ SeqAggFunc.isCount_count_nat)
    · exact GeneratesOnRF.mono h
        (rfDiffProdOps_generatesOnRF sch _ SeqAggFunc.isCount_count_nat)
