import Provenance.RecursionBases

/-!
# The bases of the recursion-free algebra in the minimal universe

The recursion-free half of the classification, in the scope of the whole
algebra's (`Provenance.RecursionBases`): queries of the algebra with no
recursion, in the minimal universe `𝒜(∅, {count})`, generated by classes
with no recursion either. The rows are the whole algebra's at the same
witnesses, all recursion-free, with `⊎` added: without a recursion it has
nothing to be derived from.
-/

variable {T : Type} [ValueType T]

/-- **Generation of the recursion-free algebra**: every query with no
recursion, over the schema and in the signature with `cnt` as its only
aggregate, is matched by one over `S`, defined and equal wherever it
is. -/
def GeneratesOnRF (T : Type) [ValueType T] (sch : Schema) (cnt : SeqAggFunc T)
    (S : Set OpKind) : Prop :=
  ∀ {n : ℕ} {κ : Fin n → ColKind} (q : AggQuery T n κ), q.usesOnly plainOps →
    GeneratesAt T sch cnt S q

theorem GeneratesOnRF.mono {sch : Schema} {cnt : SeqAggFunc T} {S S' : Set OpKind}
    (hSS : S ⊆ S') (h : GeneratesOnRF T sch cnt S) : GeneratesOnRF T sch cnt S' := by
  intro n κ q hq ho hu hi
  obtain ⟨κ', q', h₁, h₂, h₃, h₄⟩ := h q hq ho hu hi
  exact ⟨κ', q', h₁, AggQueryIn.usesOnly_mono hSS q' h₂, h₃, h₄⟩

/-- A set generating the whole algebra generates its recursion-free part. -/
theorem GeneratesOnRec.toRF {sch : Schema} {cnt : SeqAggFunc T} {S : Set OpKind}
    (h : GeneratesOnRec T sch cnt S) : GeneratesOnRF T sch cnt S :=
  fun q _ => h q

namespace RecFree

theorem plainOps_subset_plainRecOps : plainOps ⊆ plainRecOps := fun _ h =>
  Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ h)

theorem settlesAt_plain {c n : ℕ} {κ : Fin n → ColKind} {l : List (String × ℕ)}
    (q : AggQueryIn T c n κ l) (hq : q.usesOnly plainOps) :
    ∀ (D : Database T) (γ : Fin c → T), q.SettlesAt D γ :=
  AggQueryIn.settlesAt_of_usesOnly (S := plainOps)
    (by simp [plainOps, basisDD, basisOps]) (by simp [plainOps, basisDD, basisOps]) q hq

omit [ValueType T] in
theorem usesOnly_unit :
    (AggQueryIn.unit : AggQuery T 0 (ColKind.allReg 0)).usesOnly plainOps := by
  unfold AggQueryIn.unit
  rw [AggQueryIn.usesOnly_castKind]
  exact ⟨by simp [plainOps, basisDD, basisOps],
    show OpKind.empty ∈ plainOps by simp [plainOps, basisDD, basisOps]⟩

theorem inSig_unit {Θ : Set (SeqAggFunc T)} :
    (AggQueryIn.unit : AggQuery T 0 (ColKind.allReg 0)).inSig Θ := by
  unfold AggQueryIn.unit
  rw [AggQueryIn.inSig_castKind]
  exact ⟨fun j => j.elim0, fun j => j.elim0, trivial⟩

omit [ValueType T] in
theorem usesOnly_rowOf {k : ℕ} (u : Tuple T k) : (AggQueryIn.rowOf u).usesOnly plainOps := by
  unfold AggQueryIn.rowOf
  rw [AggQueryIn.usesOnly_castKind]
  exact ⟨⟨by simp [plainOps, basisDD, basisOps], fun _ => rfl⟩, usesOnly_unit⟩

theorem inSig_rowOf {Θ : Set (SeqAggFunc T)} {k : ℕ} (u : Tuple T k) :
    (AggQueryIn.rowOf u).inSig Θ := by
  unfold AggQueryIn.rowOf
  rw [AggQueryIn.inSig_castKind]
  exact ⟨fun _ => rfl, inSig_unit⟩

omit [ValueType T] in
theorem overSchema_rowOf {sch : Schema} {k : ℕ} (u : Tuple T k) :
    (AggQueryIn.rowOf u).overSchema sch := by
  unfold AggQueryIn.rowOf
  rw [AggQueryIn.overSchema_castKind]
  exact AggQueryIn.overSchema_unit

end RecFree

open RecFree in
/-- **`⊎` is in every basis of the recursion-free algebra** whose classes
hold no recursion: without it every answer on the all-empty instance has
at most one row, and the union of the unit with itself has two. -/
theorem union_mem_of_generatesOnRF {cnt : SeqAggFunc T} {S : Set OpKind}
    (hmb : OpKind.muBag ∉ S) (hms : OpKind.muSet ∉ S) {sch : Schema}
    (hS : GeneratesOnRF T sch cnt S) : OpKind.union ∈ S := by
  by_contra hu
  set u : Tuple T 0 := fun j => j.elim0 with hu0
  have hplain : (AggQueryIn.values [u, u] (by simp)).usesOnly plainOps :=
    show (AggQueryIn.Sum (AggQueryIn.rowOf u) (AggQueryIn.rowOf u)).usesOnly plainOps from
      ⟨by simp [plainOps, basisDD, basisOps], usesOnly_rowOf u, usesOnly_rowOf u⟩
  obtain ⟨κ', q', -, hu', -, he⟩ := hS _ hplain
    (show (AggQueryIn.Sum (AggQueryIn.rowOf u) (AggQueryIn.rowOf u)).overSchema sch from
      ⟨overSchema_rowOf u, overSchema_rowOf u⟩)
    (AggQueryIn.usesOnly_mono plainOps_subset_plainRecOps _ hplain)
    (show (AggQueryIn.Sum (AggQueryIn.rowOf u) (AggQueryIn.rowOf u)).inSig {cnt} from
      ⟨inSig_rowOf u, inSig_rowOf u⟩)
  have hs := he.settles ([] : Database T) (fun j => j.elim0)
    (settlesAt_plain _ hplain _ _)
  have h2 := AggQueryIn.card_values_two u ([] : Database T) (fun j => j.elim0)
  rw [hs.2] at h2
  have h1 := AggQueryIn.card_le_one_of_thin hu hmb hms q' hu' ([] : Database T)
    Database.thin_nil (fun j => j.elim0)
  omega

open RecFree in
/-- **What every generating set of the recursion-free algebra contains**,
over `ℕ` with the counting aggregate, its classes holding no recursion:
`∅`, `Π`, `⊎`, `γ` and `win`, one of `σ` and `−`, and one of `×` and the
apply. -/
theorem required_mem_of_generatesOnRF {S : Set OpKind} (hmb : OpKind.muBag ∉ S)
    (hms : OpKind.muSet ∉ S)
    (hS : ∀ sch : Schema, GeneratesOnRF ℕ sch SeqAggFunc.count S) :
    OpKind.empty ∈ S ∧ OpKind.proj ∈ S ∧ OpKind.union ∈ S ∧ OpKind.gamma ∈ S
      ∧ OpKind.win ∈ S ∧ (OpKind.sel ∈ S ∨ OpKind.diff ∈ S)
      ∧ (OpKind.prod ∈ S ∨ OpKind.apply ∈ S) :=
  ⟨empty_mem_of_generatesAt (hS _ _ usesOnly_unit),
    proj_mem_of_generatesAt (hS _ _ ⟨⟨by simp [plainOps, basisDD, basisOps], fun j => by
      have hj : j = 0 := Subsingleton.elim _ _
      subst hj
      rfl⟩, trivial⟩),
    union_mem_of_generatesOnRF hmb hms (hS Schema.empty),
    gamma_mem_of_generatesAt (hS Schema.empty _ usesOnly_unit),
    win_mem_of_generatesAt (hS _ _ ⟨by simp [plainOps], trivial⟩),
    sel_or_diff_mem_of_generatesAt (hS _ _ ⟨by simp [plainOps, basisDD, basisOps], trivial⟩),
    prod_or_apply_mem_of_generatesAt
      (hS _ _ ⟨by simp [plainOps, basisDD, basisOps], trivial, trivial⟩)⟩

/-! ## The difference in place of the selection -/

namespace DiffBasis

variable {C : ℕ}

/-- **`{a, b}` by a union**: `{a}` and what of `{b}` is not `a`. -/
def pairU (a b : T ⊕ Fin C) : AggQueryIn T C 1 (ColKind.allReg 1) :=
  AggQueryIn.Sum (param1 a) (AggQueryIn.Diff (param1 b) (param1 a))

/-- The pair by a union. -/
def prU : PairQ T := fun a b => pairU a b

theorem pairSpec_prU : PairSpec (prU (T := T)) := by
  intro C a b D γ
  refine ⟨⟨trivial, trivial, trivial⟩, ?_⟩
  show ({r1 (val γ a)} : Multiset (Tuple T 1))
      + Multiset.filter (fun t => t ∉ rows ((param1 a).evaluatePlain D γ))
        {r1 (val γ b)} = _
  rw [evaluatePlain_param1, Multiset.filter_singleton]
  have hmem : ∀ x y : T, r1 y ∈ rows ({fun _ => x} : Multiset (Tuple T 1)) ↔ x = y :=
    fun x y => ⟨fun hm => (r1_inj.mp (Multiset.mem_singleton.mp hm)).symm,
      fun hxy => by rw [hxy]; exact Multiset.mem_singleton_self _⟩
  split_ifs with h₁ h₂ h₂
  · exact add_zero (M := Multiset (Tuple T 1)) _
  · exact absurd ((hmem _ _).mp h₁) h₂
  · exact absurd ((hmem _ _).mpr h₂) h₁
  · exact Multiset.singleton_add _ _

theorem pairOK_prU {S : Set OpKind} {Θ : Set (SeqAggFunc T)} {Q : Schema → Prop}
    (hS : selTestOps ⊆ S) (hu : OpKind.union ∈ S) : PairOK S Θ Q (prU (T := T)) :=
  fun a b => {
    uses := ⟨hu, (testOK_param1 (Θ := Θ) (Q := Q) hS a).uses,
      (testOK_diff (Θ := Θ) (Q := Q) hS (testOK_param1 hS b) (testOK_param1 hS a)).uses⟩
    sig := ⟨trivial, trivial, trivial⟩
    over := fun _ _ => ⟨trivial, trivial, trivial⟩
    noM := fun _ => ⟨trivial, trivial, trivial⟩
    settles := fun _ _ => ⟨trivial, trivial, trivial⟩
    preg := ⟨fun _ => rfl, fun _ => rfl, fun _ => rfl⟩ }

end DiffBasis

/-! ## A selection by its test, decorrelated -/

namespace AggQueryIn

/-- The classes a test uses, `{a, b}` built by a union. -/
def testOps : Set OpKind := insert OpKind.union DiffBasis.selTestOps

/-- **A selection on a closed query without `σ` and without the apply**:
the test of the predicate, decorrelated over the distinct rows of the
query, holds the rows the predicate keeps, and two differences keep the
query's rows that are among them. The test uses no product and no apply,
so its decorrelation needs neither `σ` nor `ε`. -/
theorem exists_selByTest {S : Set OpKind} (he : OpKind.empty ∈ S) (hp : OpKind.proj ∈ S)
    (hd : OpKind.diff ∈ S) (hx : OpKind.prod ∈ S) (hu : OpKind.union ∈ S)
    (hg : OpKind.gamma ∈ S) (hw : OpKind.win ∈ S) (hmb : OpKind.muBag ∉ S)
    (hms : OpKind.muSet ∉ S) {Θ : Set (SeqAggFunc T)}
    {cnt : SeqAggFunc T} (hc : cnt ∈ Θ) (hcnt : cnt.IsCount) (sch : Schema) {n : ℕ}
    (φ : GenPredIn T 0 (ColKind.allReg n)) (hφ : φ.noFun = true)
    (q : AggQueryIn T 0 n (ColKind.allReg n)) (hqu : q.usesOnly S) (hqi : q.inSig Θ)
    (hqo : q.overSchema sch) :
    ∃ q' : AggQueryIn T 0 n (ColKind.allReg n), q'.usesOnly S ∧ q'.inSig Θ
      ∧ q'.overSchema sch ∧ ∀ (D : Database T) (γ : Fin 0 → T), q.SettlesAt D γ →
        q'.SettlesAt D γ ∧ q'.evaluatePlain D γ
          = @Multiset.filter _ (fun u => φ.holdsPlain u γ) (fun u => φ.decHoldsPlain u γ)
              (q.evaluatePlain D γ) := by
  classical
  have hκ : (fun j => ((Fin.append (ColKind.allReg n) (fun _ : Fin 0 => ColKind.agg)) j))
      = ColKind.allReg (n + 0) := by
    funext j
    refine Fin.addCases (fun k => ?_) (fun z => z.elim0) j
    rw [Fin.append_left]
    rfl
  -- the distinct rows of the query, as the parameter relation
  obtain ⟨P, hP⟩ : ∃ P : AggQuery T n (ColKind.allReg n), P =
      (AggQueryIn.Gamma (lab := 0) (rd := fun _ => false) (fun k => k)
        (fun j : Fin 0 => j.elim0) (fun j : Fin 0 => j.elim0) q).castKind hκ := ⟨_, rfl⟩
  have hPeval : ∀ D : Database T, (P.evaluatePlain D : Multiset (Tuple T n))
      = (q.evaluatePlain D).dedup := fun D => by
    rw [hP, AggQueryIn.evaluatePlain_castKind]
    exact (AggQueryIn.dedup_plainEquiv_gamma q D _).symm
  have hPu : P.usesOnly S := by
    rw [hP, AggQueryIn.usesOnly_castKind]; exact ⟨hg, hqu⟩
  have hPo : P.overSchema sch := by
    rw [hP, AggQueryIn.overSchema_castKind]; exact hqo
  have hPi : P.inSig Θ := by
    rw [hP, AggQueryIn.inSig_castKind]
    exact ⟨fun j => j.elim0, fun j => j.elim0, fun j => j.elim0, hqi⟩
  have hPnd : ∀ D : Database T, (P.evaluatePlain D).Nodup := fun D => by
    rw [hPeval]; exact Multiset.nodup_dedup _
  -- the test, over the classes it uses
  have hT : DiffBasis.selTestOps ⊆ testOps := Set.subset_insert _ _
  have htest := (DiffBasis.testOK_predTF (S := testOps) (Θ := Θ) (Q := fun _ => True) hT hc
    (DiffBasis.pairOK_prU hT (Set.mem_insert _ _)) φ).1
  have hU : ∀ k ∈ testOps, k ≠ OpKind.apply → k ∈ S := fun k hk _ => by
    simp only [testOps, DiffBasis.selTestOps, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hk
    rcases hk with rfl | rfl | rfl | rfl | rfl | rfl <;> assumption
  obtain ⟨T', huT, hoT, hsgT, hdT⟩ := AggQueryIn.hasDecorrelation_of_usesOnly_gen
    (S := S) (U := testOps) (sch := sch)
    (by simp [testOps, DiffBasis.selTestOps]) (by simp [testOps, DiffBasis.selTestOps])
    (fun k hk => by
      simp only [decorrCore, Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl | rfl | rfl | rfl <;> assumption)
    hU (fun h => by
      simp [testOps, DiffBasis.selTestOps] at h)
    (DiffBasis.predTF cnt DiffBasis.prU φ).1 rfl htest.uses (htest.over sch trivial)
    P hPu hPo hPnd
  have hTk : ColKind.liftKinds (n + 0) (ColKind.allReg 0) = ColKind.allReg n :=
    AggQueryIn.append_allReg _ _
  have hTs : ∀ D γ, (T'.castKind hTk).SettlesAt D γ := fun D γ =>
    (AggQueryIn.settlesAt_castKind _ _ D γ).mpr
      (AggQueryIn.settlesAt_of_usesOnly hmb hms T' huT D γ)
  have happ : ∀ v : Tuple T n, (Fin.append v (fun j : Fin 0 => j.elim0) : Tuple T (n + 0)) = v :=
    fun v => funext fun k => Fin.append_left v _ k
  have htv : ∀ (D : Database T) (v : Tuple T n),
      (DiffBasis.predTF cnt DiffBasis.prU φ).1.evaluatePlain D v
        = DiffBasis.boolRel (decide (φ.evalPlain3 v (fun j => j.elim0) = Kleene.true)) :=
    fun D v => by
      have := (DiffBasis.predTF_spec hcnt DiffBasis.pairSpec_prU φ hφ D v
        (fun j => j.elim0)).1
      rwa [happ] at this
  refine ⟨DiffBasis.inter q (T'.castKind hTk),
    ⟨hd, hqu, hd, hqu, (AggQueryIn.usesOnly_castKind _ _ _).mpr huT⟩,
    ⟨hqi, hqi, (AggQueryIn.inSig_castKind _ _ Θ).mpr (hsgT Θ hPi htest.sig htest.preg)⟩,
    ⟨hqo, hqo, (AggQueryIn.overSchema_castKind _ _).mpr hoT⟩,
    fun D γ hs => ⟨⟨hs, hs, hTs D γ⟩, ?_⟩⟩
  obtain rfl : γ = fun _ => 0 := funext fun j => j.elim0
  rw [DiffBasis.evaluatePlain_inter, AggQueryIn.evaluatePlain_castKind, hdT D]
  refine Multiset.filter_congr (fun u hu => ?_)
  have hγ0 : (fun _ => 0 : Fin 0 → T) = fun j => j.elim0 := funext fun j => j.elim0
  rw [DiffBasis.rows, Relation.mem_slices]
  constructor
  · rintro ⟨v, -, w, hw, rfl⟩
    rw [htv, DiffBasis.mem_boolRel, decide_eq_true_iff] at hw
    rw [show (Fin.append v w : Tuple T (n + 0)) = v from by
      rw [show w = fun j => j.elim0 from DiffBasis.tuple0_eq _ _]; exact happ v]
    unfold GenPredIn.holdsPlain
    rw [hγ0]
    exact hw
  · intro hh
    refine ⟨u, ?_, fun j => j.elim0, ?_, (happ u).symm⟩
    · rw [hPeval]
      exact Multiset.mem_dedup.mpr hu
    · rw [htv, DiffBasis.mem_boolRel, decide_eq_true_iff]
      unfold GenPredIn.holdsPlain at hh
      rw [hγ0] at hh
      exact hh

end AggQueryIn

/-! ## The pass to `∅`, `Π`, `σ`, `⊎`, `γ`, `win` and one of `×` and the apply -/

namespace AggQueryIn

section NotInProd

variable {c k : ℕ} (cnt : SeqAggFunc T) (q₁ q₂ : AggQueryIn T c k (ColKind.allReg k))

theorem inSig_notInDiff {Θ : Set (SeqAggFunc T)} (hc : cnt ∈ Θ) (h₁ : q₁.inSig Θ)
    (h₂ : q₂.inSig Θ) : (AggQueryIn.notInDiff cnt q₁ q₂).inSig Θ := by
  refine ⟨fun _ => rfl, AggQueryIn.noFun_notInCond, h₁, fun j => ?_, fun j => ?_, fun j => ?_,
    ⟨fun j => AggQueryIn.noFun_tagCols 0 j, h₁⟩, ⟨fun j => AggQueryIn.noFun_tagCols _ j, h₂⟩⟩
  · rw [Subsingleton.elim j 0]; rfl
  · rw [Subsingleton.elim j 0]; exact hc
  · rw [Subsingleton.elim j 0]; rfl

theorem settlesAt_notInDiff (D : Database T) (γ : Fin c → T) (h₁ : q₁.SettlesAt D γ)
    (h₂ : q₂.SettlesAt D γ) : (AggQueryIn.notInDiff cnt q₁ q₂).SettlesAt D γ :=
  ⟨h₁, h₁, h₂⟩

end NotInProd

omit [ValueType T] in
theorem paramsReg_explodeBelow {c n : ℕ} :
    ∀ (m : ℕ) {κ : Fin n → ColKind} {l : List (String × ℕ)} (q : AggQueryIn T c n κ l),
      (q.explodeBelow m).paramsReg ↔ q.paramsReg := by
  intro m
  induction m with
  | zero =>
    intro κ l q
    show ((q.castKind _).paramsReg) ↔ _
    rw [AggQueryIn.paramsReg_castKind]
  | succ m ih =>
    intro κ l q
    unfold AggQueryIn.explodeBelow
    split
    · split
      · rw [AggQueryIn.paramsReg_castKind]
        show (AggQueryIn.Explode _ _ (q.explodeBelow m)).paramsReg ↔ _
        exact ih q
      · rw [AggQueryIn.paramsReg_castKind]
        exact ih q
      · show (AggQueryIn.Retag _ (q.explodeBelow m)).paramsReg ↔ _
        exact ih q
    · rw [AggQueryIn.paramsReg_castKind]
      exact ih q

omit [ValueType T] in
theorem paramsReg_allRegOf {c n : ℕ} {κ : Fin n → ColKind} {l : List (String × ℕ)}
    (q : AggQueryIn T c n κ l) : (q.allRegOf).paramsReg ↔ q.paramsReg := by
  rw [AggQueryIn.allRegOf, AggQueryIn.paramsReg_castKind, paramsReg_explodeBelow]

theorem paramsReg_winKept {c n m p : ℕ} (P : Tuple (Fin n) m) (O : Tuple (Fin n) p)
    (o : OrderSpec p) (w : ValueFrame T p) {hsql : w.IsSQL o} (t : TermIn T c n) (f : SeqAggFunc T)
    (κ : Fin n → ColKind) (q : AggQueryIn T c n (ColKind.allReg n)) (dist : Bool)
    (keep : Option (Selection T n)) (h : q.paramsReg) :
    (winKept (hsql := sql_frame%) P O o w t f κ q dist keep).paramsReg := by
  rw [winKept, AggQueryIn.paramsReg_castKind]
  show (doubled κ q).paramsReg
  rw [doubled, AggQueryIn.paramsReg_castKind]
  exact h

/-- **The recursion-free pass**: a query with no recursion, over the
classes `U`, in a signature holding a counting aggregate, over a schema, is
matched by one with all-regular columns over `S`, in the signature, over
the schema, defined and equal wherever the source is. `S` holds `∅`, `Π`,
`⊎`, `γ`, `win`, one of `σ` and `−` (both `−` and `×` where it has no `σ`),
and one of `×` and the apply (the apply, and `σ`, where `U` has the
apply).
- a product stays one where `S` has `×`, and becomes an apply otherwise;
- a difference stays one where `S` has `−`, and becomes the `NOT IN` form
  otherwise;
- a selection stays one where `S` has `σ`, and is otherwise kept by its test,
  decorrelated over the distinct rows of its input – which needs the query
  closed, hence no apply in `U`;
- a duplicate elimination becomes a grouping, and a window stays a window.
Where `S` has `×` and `σ`, every parameter leaf of the result is regular,
which is what its decorrelation asks. -/
theorem exists_rfPass {S U : Set OpKind} (he : OpKind.empty ∈ S) (hp : OpKind.proj ∈ S)
    (hs : OpKind.sel ∈ S ∨ (OpKind.diff ∈ S ∧ OpKind.prod ∈ S)) (hu : OpKind.union ∈ S)
    (hg : OpKind.gamma ∈ S) (hw : OpKind.win ∈ S) (hx : OpKind.prod ∈ S ∨ OpKind.apply ∈ S)
    (hmbS : OpKind.muBag ∉ S) (hmsS : OpKind.muSet ∉ S) (hU : U ⊆ plainOps)
    (hUa : OpKind.apply ∈ U → OpKind.apply ∈ S ∧ OpKind.sel ∈ S) {Θ : Set (SeqAggFunc T)}
    (cnt : SeqAggFunc T) (hcnt : cnt ∈ Θ) (hci : cnt.IsCount) (sch : Schema) :
    ∀ {c n : ℕ} {κ : Fin n → ColKind} {l : List (String × ℕ)} (q : AggQueryIn T c n κ l),
      l = [] → (c = 0 ∨ OpKind.sel ∈ S) → q.usesOnly U → q.inSig Θ → q.overSchema sch →
      ∃ q' : AggQueryIn T c n (ColKind.allReg n), q'.usesOnly S ∧ q'.inSig Θ
        ∧ (OpKind.prod ∈ S → OpKind.sel ∈ S → q'.paramsReg) ∧ q'.overSchema sch
        ∧ ∀ (D : Database T) (γ : Fin c → T), q.SettlesAt D γ →
            q'.SettlesAt D γ ∧ q.evaluatePlain D γ = q'.evaluatePlain D γ := by
  have hcc := hci.counts
  have hmb : OpKind.muBag ∉ U := fun h => by
    have := hU h
    simp [plainOps, basisDD, basisOps] at this
  have hms : OpKind.muSet ∉ U := fun h => by
    have := hU h
    simp [plainOps, basisDD, basisOps] at this
  -- a product, as `S` writes it
  have hprod : ∀ {c n₁ n₂ : ℕ} (p₁ : AggQueryIn T c n₁ (ColKind.allReg n₁))
      (p₂ : AggQueryIn T c n₂ (ColKind.allReg n₂)), p₁.usesOnly S → p₂.usesOnly S →
      ∃ p : AggQueryIn T c (n₁ + n₂) (ColKind.allReg (n₁ + n₂)), p.usesOnly S
        ∧ (∀ Θ', p₁.inSig Θ' → p₂.inSig Θ' → p.inSig Θ')
        ∧ (OpKind.prod ∈ S → p₁.paramsReg → p₂.paramsReg → p.paramsReg)
        ∧ (p₁.overSchema sch → p₂.overSchema sch → p.overSchema sch)
        ∧ ∀ (D : Database T) (γ : Fin c → T), p₁.SettlesAt D γ → p₂.SettlesAt D γ →
            p.SettlesAt D γ
              ∧ p.evaluatePlain D γ = p₁.evaluatePlain D γ * p₂.evaluatePlain D γ := by
    intro c n₁ n₂ p₁ p₂ h₁ h₂
    by_cases hx' : OpKind.prod ∈ S
    · exact ⟨(AggQueryIn.Prod p₁ p₂).castKind (AggQueryIn.append_allReg _ _),
        (AggQueryIn.usesOnly_castKind _ _ _).mpr ⟨hx', h₁, h₂⟩,
        fun Θ' i₁ i₂ => (AggQueryIn.inSig_castKind _ _ Θ').mpr ⟨i₁, i₂⟩,
        fun _ r₁ r₂ => (AggQueryIn.paramsReg_castKind _ _).mpr ⟨r₁, r₂⟩,
        fun o₁ o₂ => (AggQueryIn.overSchema_castKind _ _).mpr ⟨o₁, o₂⟩,
        fun D γ s₁ s₂ => ⟨(AggQueryIn.settlesAt_castKind _ _ D γ).mpr ⟨s₁, s₂⟩,
          by rw [AggQueryIn.evaluatePlain_castKind]; rfl⟩⟩
    · have ha := hx.resolve_left hx'
      exact ⟨AggQueryIn.prodA p₁ p₂, AggQueryIn.usesOnly_prodA p₁ p₂ ha h₁ h₂,
        fun Θ' i₁ i₂ => AggQueryIn.inSig_prodA p₁ p₂ i₁ i₂, fun h => absurd h hx',
        fun o₁ o₂ => AggQueryIn.overSchema_prodA p₁ p₂ o₁ o₂,
        fun D γ s₁ s₂ => ⟨AggQueryIn.settlesAt_prodA p₁ p₂ D γ s₁ s₂,
          AggQueryIn.evaluatePlain_prodA p₁ p₂ D γ⟩⟩
  intro c n κ l q
  induction q with
  | Rel n s =>
    exact fun _ _ _ _ ho => ⟨AggQueryIn.Rel n s, trivial, trivial, fun _ _ => trivial, ho,
      fun _ _ h => ⟨h, rfl⟩⟩
  | Hole n s κh => exact fun hl => absurd hl (by simp)
  | Param pv ρ =>
    exact fun _ _ _ _ _ => ⟨AggQueryIn.Param pv (ColKind.allReg _), ⟨he, hp, hg⟩, trivial,
      fun _ _ _ => rfl, trivial, fun _ _ _ => ⟨trivial, rfl⟩⟩
  | Empty =>
    exact fun _ _ _ _ _ => ⟨AggQueryIn.Empty, he, trivial, fun _ _ => trivial, trivial,
      fun _ _ _ => ⟨trivial, rfl⟩⟩
  | Proj ps q ih =>
    intro hl hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih hl hc0 hq.2 hi.2 ho
    have hcols : ∀ j, ((ps j).toReg).sourceCol = true := fun j => by cases ps j <;> rfl
    refine ⟨(AggQueryIn.Proj (fun j => (ps j).toReg) q').castKind
        (funext fun j => ProjColIn.kind_toReg (ps j)), ?_, ?_,
      fun h h' => (AggQueryIn.paramsReg_castKind _ _).mpr (hr' h h'),
      (AggQueryIn.overSchema_castKind _ _).mpr ho', fun D γ hset => ?_⟩
    · rw [AggQueryIn.usesOnly_castKind]
      exact ⟨⟨hp, hcols⟩, hu'⟩
    · rw [AggQueryIn.inSig_castKind]
      exact ⟨fun j => ProjColIn.noFun_toReg (hq.1.2 j) (hi.1 j), hi'⟩
    · obtain ⟨hs', he''⟩ := he' D γ hset
      refine ⟨by rw [AggQueryIn.settlesAt_castKind]; exact hs', ?_⟩
      rw [AggQueryIn.evaluatePlain_castKind]
      simp only [AggQueryIn.evaluatePlain]
      rw [he'']
      refine Multiset.map_congr rfl (fun u _ => funext (fun j => ?_))
      exact (ProjColIn.evalPlain_toReg (ps j) (hq.1.2 j) u γ).symm
  | Sel φ q hφ ih =>
    intro hl hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih hl hc0 hq.2 hi.2 ho
    have hsrc : ∀ D γ, q.SettlesAt D γ →
        (AggQueryIn.Sel φ q hφ).evaluatePlain D γ
          = @Multiset.filter _ (fun u => φ.toReg.holdsPlain u γ)
              (fun u => φ.toReg.decHoldsPlain u γ) (q'.evaluatePlain D γ) := fun D γ h => by
      simp only [AggQueryIn.evaluatePlain]
      rw [(he' D γ h).2]
      exact Multiset.filter_congr (fun u _ => (GenPredIn.holdsPlain_toReg φ u γ).symm)
    by_cases hsel : OpKind.sel ∈ S
    · refine ⟨AggQueryIn.Sel φ.toReg q' trivial, ⟨hsel, hu'⟩, ⟨GenPredIn.noFun_toReg hi.1, hi'⟩,
        hr', ho', fun D γ hset => ⟨(he' D γ hset).1, hsrc D γ hset⟩⟩
    · obtain ⟨hdS, hxS⟩ := hs.resolve_left hsel
      rcases hc0 with hc0 | hc0
      · subst hc0
        obtain ⟨p, hpu, hpi, hpo, hpe⟩ := exists_selByTest he hp hdS hxS hu hg hw hmbS hmsS hcnt
          hci sch φ.toReg (GenPredIn.noFun_toReg hi.1) q' hu' hi' ho'
        exact ⟨p, hpu, hpi, fun _ h => absurd h hsel, hpo, fun D γ hset =>
          ⟨(hpe D γ (he' D γ hset).1).1,
            (hsrc D γ hset).trans (hpe D γ (he' D γ hset).1).2.symm⟩⟩
      · exact absurd hc0 hsel
  | Prod q₁ q₂ ih₁ ih₂ =>
    intro hl hc0 hq hi ho
    obtain ⟨hl₁, hl₂⟩ := List.append_eq_nil_iff.mp hl
    obtain ⟨q₁', hu₁, hi₁, hr₁, ho₁, he₁⟩ := ih₁ hl₁ hc0 hq.2.1 hi.1 ho.1
    obtain ⟨q₂', hu₂, hi₂, hr₂, ho₂, he₂⟩ := ih₂ hl₂ hc0 hq.2.2 hi.2 ho.2
    obtain ⟨p, hpu, hpi, hpr, hpo, hpe⟩ := hprod q₁' q₂' hu₁ hu₂
    refine ⟨p, hpu, hpi Θ hi₁ hi₂, fun h h' => hpr h (hr₁ h h') (hr₂ h h'), hpo ho₁ ho₂,
      fun D γ hset => ⟨(hpe D γ (he₁ D γ hset.1).1 (he₂ D γ hset.2).1).1, ?_⟩⟩
    rw [(hpe D γ (he₁ D γ hset.1).1 (he₂ D γ hset.2).1).2, ← (he₁ D γ hset.1).2,
      ← (he₂ D γ hset.2).2]
    rfl
  | Apply q₁ q₂ ih₁ ih₂ =>
    intro hl hc0 hq hi ho
    obtain ⟨haS, hselS⟩ := hUa hq.1
    obtain ⟨q₁', hu₁, hi₁, hr₁, ho₁, he₁⟩ := ih₁ hl hc0 hq.2.1 hi.1 ho.1
    obtain ⟨q₂', hu₂, hi₂, hr₂, ho₂, he₂⟩ := ih₂ rfl (Or.inr hselS) hq.2.2 hi.2 ho.2
    refine ⟨(AggQueryIn.Apply q₁' q₂').castKind (AggQueryIn.append_allReg _ _), ?_, ?_,
      fun h h' => (AggQueryIn.paramsReg_castKind _ _).mpr ⟨hr₁ h h', hr₂ h h'⟩,
      (AggQueryIn.overSchema_castKind _ _).mpr ⟨ho₁, ho₂⟩, fun D γ hset => ?_⟩
    · rw [AggQueryIn.usesOnly_castKind]
      exact ⟨haS, hu₁, hu₂⟩
    · rw [AggQueryIn.inSig_castKind]
      exact ⟨hi₁, hi₂⟩
    · obtain ⟨hs₁, he₁'⟩ := he₁ D γ hset.1
      have hmem : ∀ u, Multiset.Mem (q₁'.evaluatePlain D γ) u →
          Multiset.Mem (q₁.evaluatePlain D γ) u := fun u hu' => by rw [he₁']; exact hu'
      refine ⟨by
        rw [AggQueryIn.settlesAt_castKind]
        exact ⟨hs₁, fun u hu' => (he₂ D _ (hset.2 u (hmem u hu'))).1⟩, ?_⟩
      rw [AggQueryIn.evaluatePlain_castKind]
      simp only [AggQueryIn.evaluatePlain]
      rw [he₁']
      exact Multiset.bind_congr fun u hu' =>
        congrArg _ (he₂ D _ (hset.2 u (hmem u hu'))).2
  | Sum q₁ q₂ ih₁ ih₂ =>
    intro hl hc0 hq hi ho
    obtain ⟨hl₁, hl₂⟩ := List.append_eq_nil_iff.mp hl
    obtain ⟨q₁', hu₁, hi₁, hr₁, ho₁, he₁⟩ := ih₁ hl₁ hc0 hq.2.1 hi.1 ho.1
    obtain ⟨q₂', hu₂, hi₂, hr₂, ho₂, he₂⟩ := ih₂ hl₂ hc0 hq.2.2 hi.2 ho.2
    refine ⟨AggQueryIn.Sum q₁' q₂', ⟨hu, hu₁, hu₂⟩, ⟨hi₁, hi₂⟩,
      fun h h' => ⟨hr₁ h h', hr₂ h h'⟩, ⟨ho₁, ho₂⟩,
      fun D γ hset => ⟨⟨(he₁ D γ hset.1).1, (he₂ D γ hset.2).1⟩, ?_⟩⟩
    simp only [AggQueryIn.evaluatePlain]
    rw [(he₁ D γ hset.1).2, (he₂ D γ hset.2).2]
  | @Dedup cd nd q ih =>
    intro _ hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih rfl hc0 hq.2 hi ho
    have hκ : (fun j => ((Fin.append (ColKind.allReg nd) (fun _ : Fin 0 => ColKind.agg)) j))
        = ColKind.allReg (nd + 0) := by
      funext j
      refine Fin.addCases (fun k => ?_) (fun z => z.elim0) j
      rw [Fin.append_left]
      rfl
    refine ⟨(AggQueryIn.Gamma (lab := 0) (rd := fun _ => false) (fun k => k)
        (fun j : Fin 0 => j.elim0) (fun j : Fin 0 => j.elim0) q').castKind hκ, ?_, ?_,
      fun h h' => (AggQueryIn.paramsReg_castKind _ _).mpr (hr' h h'),
      (AggQueryIn.overSchema_castKind _ _).mpr ho', fun D γ hset => ?_⟩
    · rw [AggQueryIn.usesOnly_castKind]
      exact ⟨hg, hu'⟩
    · rw [AggQueryIn.inSig_castKind]
      exact ⟨fun j => j.elim0, fun j => j.elim0, fun j => j.elim0, hi'⟩
    · obtain ⟨hs', he''⟩ := he' D γ hset
      refine ⟨by rw [AggQueryIn.settlesAt_castKind]; exact hs', ?_⟩
      rw [AggQueryIn.evaluatePlain_castKind]
      refine Eq.trans ?_ (AggQueryIn.dedup_plainEquiv_gamma q' D γ)
      simp only [AggQueryIn.evaluatePlain]
      rw [he'']
  | Diff q₁ q₂ ih₁ ih₂ =>
    intro _ hc0 hq hi ho
    obtain ⟨q₁', hu₁, hi₁, hr₁, ho₁, he₁⟩ := ih₁ rfl hc0 hq.2.1 hi.1 ho.1
    obtain ⟨q₂', hu₂, hi₂, hr₂, ho₂, he₂⟩ := ih₂ rfl hc0 hq.2.2 hi.2 ho.2
    have hD : ∀ D γ, q₁.SettlesAt D γ → q₂.SettlesAt D γ →
        (AggQueryIn.Diff q₁ q₂).evaluatePlain D γ
          = (AggQueryIn.Diff q₁' q₂').evaluatePlain D γ := fun D γ h₁ h₂ => by
      simp only [AggQueryIn.evaluatePlain]
      rw [(he₁ D γ h₁).2, (he₂ D γ h₂).2]
    by_cases hdS : OpKind.diff ∈ S
    · exact ⟨AggQueryIn.Diff q₁' q₂', ⟨hdS, hu₁, hu₂⟩, ⟨hi₁, hi₂⟩,
        fun h h' => ⟨hr₁ h h', hr₂ h h'⟩, ⟨ho₁, ho₂⟩,
        fun D γ hset => ⟨⟨(he₁ D γ hset.1).1, (he₂ D γ hset.2).1⟩, hD D γ hset.1 hset.2⟩⟩
    have hsS : OpKind.sel ∈ S := hs.resolve_right (fun h => hdS h.1)
    by_cases hpS : OpKind.prod ∈ S
    · refine ⟨AggQueryIn.notInDiff cnt q₁' q₂',
        AggQueryIn.usesOnly_notInDiff cnt hp hsS hpS hu hg hu₁ hu₂,
        inSig_notInDiff cnt q₁' q₂' hcnt hi₁ hi₂, fun h h' => ⟨hr₁ h h', hr₁ h h', hr₂ h h'⟩,
        AggQueryIn.overSchema_notInDiff cnt ho₁ ho₂,
        fun D γ hset => ⟨settlesAt_notInDiff cnt q₁' q₂' D γ (he₁ D γ hset.1).1
          (he₂ D γ hset.2).1, ?_⟩⟩
      rw [hD D γ hset.1 hset.2, AggQueryIn.diff_plainEquiv_notIn cnt hcc q₁' q₂' D γ]
    · have ha := hx.resolve_left hpS
      refine ⟨AggQueryIn.notInDiffA cnt q₁' q₂',
        AggQueryIn.usesOnly_notInDiffA cnt q₁' q₂' hp hsS ha hu hg hu₁ hu₂,
        AggQueryIn.inSig_notInDiffA cnt q₁' q₂' hcnt hi₁ hi₂, fun h => absurd h hpS,
        AggQueryIn.overSchema_notInDiffA cnt q₁' q₂' ho₁ ho₂,
        fun D γ hset => ⟨AggQueryIn.settlesAt_notInDiffA cnt q₁' q₂' D γ (he₁ D γ hset.1).1
          (he₂ D γ hset.2).1, ?_⟩⟩
      rw [hD D γ hset.1 hset.2, AggQueryIn.diff_plainEquiv_notIn cnt hcc q₁' q₂' D γ,
        AggQueryIn.evaluatePlain_notInDiffA]
  | Explode k hk q ih =>
    intro hl hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih hl hc0 hq hi ho
    exact ⟨q', hu', hi', hr', ho', he'⟩
  | Retag hk q ih =>
    intro hl hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih hl hc0 hq hi ho
    exact ⟨q', hu', hi', hr', ho', he'⟩
  | Mu s q₀ q₁ ih₀ ih₁ => exact fun _ _ hq => absurd hq.1 hmb
  | MuSet s q₀ q₁ ih₀ ih₁ => exact fun _ _ hq => absurd hq.1 hms
  | Gamma is ts fs q keep ord ih =>
    intro _ hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih rfl hc0 hq.2 hi.2.2.2 ho
    refine ⟨(AggQueryIn.Gamma (lab := 0) (rd := fun _ => false) is ts fs q' keep
        ord).allRegOf, ?_, ?_, fun h h' => (paramsReg_allRegOf _).mpr (hr' h h'),
      (AggQueryIn.overSchema_allRegOf _).mpr ho', fun D γ hset => ?_⟩
    · rw [AggQueryIn.usesOnly_allRegOf]
      exact ⟨hg, hu'⟩
    · rw [AggQueryIn.inSig_allRegOf]
      exact ⟨hi.1, hi.2.1, hi.2.2.1, hi'⟩
    · obtain ⟨hs', he''⟩ := he' D γ hset
      refine ⟨by rw [AggQueryIn.settlesAt_allRegOf]; exact hs', ?_⟩
      rw [AggQueryIn.evaluatePlain_allRegOf]
      simp only [AggQueryIn.evaluatePlain]
      rw [he'']
  | GammaScalar ts fs q ord ih =>
    intro _ hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih rfl hc0 hq.2 hi.2.2 ho
    refine ⟨(AggQueryIn.GammaScalar (lab := 0) (rd := fun _ => false) ts fs q'
        ord).allRegOf, ?_, ?_, fun h h' => (paramsReg_allRegOf _).mpr (hr' h h'),
      (AggQueryIn.overSchema_allRegOf _).mpr ho', fun D γ hset => ?_⟩
    · rw [AggQueryIn.usesOnly_allRegOf]
      exact ⟨hg, hu'⟩
    · rw [AggQueryIn.inSig_allRegOf]
      exact ⟨hi.1, hi.2.1, hi'⟩
    · obtain ⟨hs', he''⟩ := he' D γ hset
      refine ⟨by rw [AggQueryIn.settlesAt_allRegOf]; exact hs', ?_⟩
      rw [AggQueryIn.evaluatePlain_allRegOf]
      simp only [AggQueryIn.evaluatePlain]
      rw [he'']
  | GammaNest is his pc fn q ih =>
    intro _ hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih rfl hc0 hq.2 hi.2.2 ho
    refine ⟨(AggQueryIn.GammaNest (lab := 0) (rd := fun _ => false) is (fun k hc =>
        ColKind.noConfusion hc) pc.toReg fn q').allRegOf, ?_, ?_,
      fun h h' => by rw [paramsReg_allRegOf]; exact hr' h h',
      by rw [AggQueryIn.overSchema_allRegOf]; exact ho', fun D γ hset => ?_⟩
    · rw [AggQueryIn.usesOnly_allRegOf]
      exact ⟨⟨hg, by rw [show (pc.toReg).sourceCol = true from by cases pc <;> rfl]⟩, hu'⟩
    · rw [AggQueryIn.inSig_allRegOf]
      exact ⟨ProjColIn.noFun_toReg hq.1.2 hi.1, hi.2.1, hi'⟩
    · obtain ⟨hs', he''⟩ := he' D γ hset
      refine ⟨by rw [AggQueryIn.settlesAt_allRegOf]; exact hs', ?_⟩
      rw [AggQueryIn.evaluatePlain_allRegOf]
      simp only [AggQueryIn.evaluatePlain]
      rw [he'']
      refine Multiset.map_congr rfl (fun g _ => ?_)
      funext j
      refine Fin.addCases (fun k => ?_) (fun z => ?_) j
      · rw [Fin.append_left, Fin.append_left]
      · rw [Fin.append_right, Fin.append_right]
        refine congrArg fn (Multiset.map_congr rfl (fun u _ => ?_))
        exact (ProjColIn.evalPlain_toReg pc hq.1.2 u γ).symm
  | GammaTok is his ts fs a q keep ih => exact fun _ _ hq => hq.elim
  | ProvSum is his t q ih => exact fun _ _ hq => hq.elim
  | @Win cw nw _mw _pw _κw _lab _rd P' O o w _ t fw q hrr dist keep ih =>
    intro _ hc0 hq hi ho
    obtain ⟨q', hu', hi', hr', ho', he'⟩ := ih rfl hc0 hq.2 hi.2.2.2.2 ho
    refine ⟨(winKept (hsql := sql_frame%) P' O o w t fw _κw q' dist keep).allRegOf, ?_, ?_,
      fun h h' => (paramsReg_allRegOf _).mpr (paramsReg_winKept P' O o w t fw _κw q' dist keep
        (hr' h h')),
      (AggQueryIn.overSchema_allRegOf _).mpr
        (overSchema_winKept (hsql := sql_frame%) P' O o w t fw _κw q' dist keep ho'), fun D γ hset
          => ?_⟩
    · rw [AggQueryIn.usesOnly_allRegOf]
      exact usesOnly_winKept P' O o w t fw _κw q' dist keep hw hp hu'
    · rw [AggQueryIn.inSig_allRegOf]
      exact inSig_winKept P' O o w t fw _κw q' dist keep hi.1 hi.2.1 hi.2.2.1 hi.2.2.2.1 hi'
    · obtain ⟨hs', he''⟩ := he' D γ hset
      refine ⟨by rw [AggQueryIn.settlesAt_allRegOf]
                 exact settlesAt_winKept P' O o w t fw _κw q' dist keep D γ hs', ?_⟩
      rw [AggQueryIn.evaluatePlain_allRegOf,
        evaluatePlain_winKept P' O o w t fw q hrr q' dist keep D γ he'']
  | WinExpr P' O o ws ts fs g q keeps ih => exact fun _ _ _ hi => hi.elim

end AggQueryIn

/-! ## The four candidate bases -/

/-- `{∅, Π, σ, apply, ⊎, γ, win}`. -/
def rfSelApplyOps : Set OpKind :=
  {OpKind.empty, OpKind.proj, OpKind.sel, OpKind.apply, OpKind.union, OpKind.gamma, OpKind.win}

/-- `{∅, Π, σ, ×, ⊎, γ, win}`. -/
def rfSelProdOps : Set OpKind :=
  {OpKind.empty, OpKind.proj, OpKind.sel, OpKind.prod, OpKind.union, OpKind.gamma, OpKind.win}

/-- `{∅, Π, −, apply, ⊎, γ, win}`. -/
def rfDiffApplyOps : Set OpKind :=
  {OpKind.empty, OpKind.proj, OpKind.diff, OpKind.apply, OpKind.union, OpKind.gamma, OpKind.win}

/-- `{∅, Π, −, ×, ⊎, γ, win}`. -/
def rfDiffProdOps : Set OpKind :=
  {OpKind.empty, OpKind.proj, OpKind.diff, OpKind.prod, OpKind.union, OpKind.gamma, OpKind.win}

/-- **`{∅, Π, σ, apply, ⊎, γ, win}` generates the recursion-free algebra**
in the minimal universe. -/
theorem rfSelApplyOps_generatesOnRF (sch : Schema) (cnt : SeqAggFunc T) (hcnt : cnt.IsCount) :
    GeneratesOnRF T sch cnt rfSelApplyOps := by
  intro n κ q hq ho _ hi
  obtain ⟨q', hu', hi', -, ho', he'⟩ := AggQueryIn.exists_rfPass (S := rfSelApplyOps)
    (by simp [rfSelApplyOps]) (by simp [rfSelApplyOps]) (Or.inl (by simp [rfSelApplyOps]))
    (by simp [rfSelApplyOps]) (by simp [rfSelApplyOps]) (by simp [rfSelApplyOps])
    (Or.inr (by simp [rfSelApplyOps])) (by simp [rfSelApplyOps]) (by simp [rfSelApplyOps])
    (subset_refl _) (fun _ => ⟨by simp [rfSelApplyOps], by simp [rfSelApplyOps]⟩)
    cnt (Set.mem_singleton cnt) hcnt sch q rfl (Or.inl rfl) hq hi ho
  exact ⟨_, q', ho', hu', hi', AggQueryIn.Extends.of_settles he'⟩

theorem selTestOps_subset_rfDiffApplyOps : DiffBasis.selTestOps ⊆ rfDiffApplyOps := by
  intro k hk
  simp only [DiffBasis.selTestOps, Set.mem_insert_iff, Set.mem_singleton_iff] at hk
  simp only [rfDiffApplyOps, Set.mem_insert_iff, Set.mem_singleton_iff]
  tauto

/-- **`{∅, Π, −, apply, ⊎, γ, win}` generates the recursion-free algebra**
in the minimal universe: the match over `{∅, Π, σ, apply, ⊎, γ, win}`,
each selection then an apply of its test, `{a, b}` built by a union. -/
theorem rfDiffApplyOps_generatesOnRF (sch : Schema) (cnt : SeqAggFunc T)
    (hcnt : cnt.IsCount) : GeneratesOnRF T sch cnt rfDiffApplyOps := by
  intro n κ q hq ho hr hi
  obtain ⟨κ₁, q₁, ho₁, hu₁, hi₁, hx₁⟩ := rfSelApplyOps_generatesOnRF sch cnt hcnt q hq ho hr hi
  obtain ⟨f, -, -, hfr⟩ := AggQueryIn.exists_freshSupply sch q₁.names
  obtain ⟨q₂, hu₂, hi₂, ho₂, -, he⟩ := DiffBasis.exists_selPass_of (Θ := {cnt})
    (Q := fun _ => True) (Src := rfSelApplyOps) (Tgt := rfDiffApplyOps)
    (fun k hk hne => by
      simp only [rfSelApplyOps, Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      simp only [rfDiffApplyOps, Set.mem_insert_iff, Set.mem_singleton_iff]
      rcases hk with h | h | h | h | h | h | h <;> simp_all)
    (by simp [rfDiffApplyOps]) selTestOps_subset_rfDiffApplyOps (by simp [rfSelApplyOps])
    (Set.mem_singleton cnt) hcnt DiffBasis.pairSpec_prU
    (DiffBasis.pairOK_prU selTestOps_subset_rfDiffApplyOps (by simp [rfDiffApplyOps]))
    (f 0) (fun _ _ _ _ _ => trivial) q₁ hu₁ hi₁ (hfr 0)
  exact ⟨κ₁, q₂, ho₂ sch trivial ho₁, hu₂, hi₂,
    fun D γ r h => (AggQueryIn.Extends.of_settles fun D γ hs => he D γ hs) D γ r (hx₁ D γ r h)⟩

/-! ## The product in place of the apply -/

/-- The classes the decorrelation lands in, windows and groupings kept. -/
def rfDecOps : Set OpKind :=
  {OpKind.empty, OpKind.proj, OpKind.sel, OpKind.prod, OpKind.union, OpKind.dedup, OpKind.diff,
    OpKind.gamma, OpKind.win}

/-- **The match without applies**: over `{∅, Π, σ, ×, ⊎, ε, −, γ, win}`, in
the signature, defined everywhere and equal to the source. The source is
first matched over `{∅, Π, σ, ×, apply, ⊎, γ, win}`, every parameter leaf
regular, and its applies are then decorrelated in the signature
(`exists_applyFree_plainEquiv_sig`). -/
theorem exists_rfDec (sch : Schema) {cnt : SeqAggFunc T} (hcnt : cnt.IsCount) {n : ℕ}
    {κ : Fin n → ColKind} (q : AggQuery T n κ) (hq : q.usesOnly plainOps)
    (ho : q.overSchema sch) (hi : q.inSig {cnt}) :
    ∃ q₂ : AggQuery T n (ColKind.allReg n), q₂.usesOnly rfDecOps ∧ q₂.overSchema sch
      ∧ q₂.inSig {cnt} ∧ (∀ D γ, q₂.SettlesAt D γ)
      ∧ ∀ D γ, q.SettlesAt D γ ∧ q.evaluatePlain D γ = q₂.evaluatePlain D γ := by
  obtain ⟨q₁, hu₁, hi₁, hr₁, ho₁, he₁⟩ := AggQueryIn.exists_rfPass
    (S := {OpKind.empty, OpKind.proj, OpKind.sel, OpKind.prod, OpKind.apply, OpKind.union,
      OpKind.gamma, OpKind.win})
    (by simp) (by simp) (Or.inl (by simp)) (by simp) (by simp) (by simp) (Or.inl (by simp))
    (by simp) (by simp) (subset_refl _) (fun _ => ⟨by simp, by simp⟩) cnt
    (Set.mem_singleton cnt) hcnt sch q rfl (Or.inl rfl) hq hi ho
  have hu₁' : q₁.usesOnly (insert OpKind.apply rfDecOps) :=
    AggQueryIn.usesOnly_mono (fun k hk => by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      simp only [rfDecOps, Set.mem_insert_iff, Set.mem_singleton_iff]
      tauto) q₁ hu₁
  obtain ⟨q₂, hu₂, ho₂, hsg₂, he₂⟩ := AggQueryIn.exists_applyFree_plainEquiv_sig
    (S := rfDecOps) (by simp [decorrOps, rfDecOps, Set.insert_subset_iff]) (by simp [rfDecOps])
    (by simp [rfDecOps]) (by simp [rfDecOps]) q₁ hu₁' ho₁
  have hs₂ : ∀ D γ, q₂.SettlesAt D γ :=
    AggQueryIn.settlesAt_of_usesOnly (S := rfDecOps) (by simp [rfDecOps]) (by simp [rfDecOps])
      q₂ hu₂
  have hsq : ∀ D γ, q.SettlesAt D γ := RecFree.settlesAt_plain q hq
  exact ⟨q₂, hu₂, ho₂, hsg₂ {cnt} hi₁ (hr₁ (by simp) (by simp)), hs₂,
    fun D γ => ⟨hsq D γ, ((he₁ D γ (hsq D γ)).2).trans (he₂ D γ)⟩⟩

/-- **`{∅, Π, σ, ×, ⊎, γ, win}` generates the recursion-free algebra** in
the minimal universe: the match without applies, its duplicate
eliminations and differences rewritten. -/
theorem rfSelProdOps_generatesOnRF (sch : Schema) (cnt : SeqAggFunc T) (hcnt : cnt.IsCount) :
    GeneratesOnRF T sch cnt rfSelProdOps := by
  intro n κ q hq ho _ hi
  obtain ⟨q₂, hu₂, ho₂, hi₂, hs₂, he₂⟩ := exists_rfDec sch hcnt q hq ho hi
  obtain ⟨q₃, hu₃, hi₃, -, ho₃, he₃⟩ := AggQueryIn.exists_rfPass (S := rfSelProdOps)
    (U := rfDecOps) (by simp [rfSelProdOps]) (by simp [rfSelProdOps])
    (Or.inl (by simp [rfSelProdOps])) (by simp [rfSelProdOps]) (by simp [rfSelProdOps])
    (by simp [rfSelProdOps]) (Or.inl (by simp [rfSelProdOps])) (by simp [rfSelProdOps])
    (by simp [rfSelProdOps])
    (fun k hk => by
      simp only [rfDecOps, Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      simp only [plainOps, basisDD, basisOps, Set.mem_insert_iff, Set.mem_singleton_iff]
      tauto)
    (fun h => absurd h (by simp [rfDecOps])) cnt (Set.mem_singleton cnt) hcnt sch q₂ rfl
    (Or.inl rfl) hu₂ hi₂ ho₂
  refine ⟨_, q₃, ho₃, hu₃, hi₃, AggQueryIn.Extends.of_settles fun D γ _ => ?_⟩
  obtain ⟨hs₃, he₃'⟩ := he₃ D γ (hs₂ D γ)
  exact ⟨hs₃, (he₂ D γ).2.trans he₃'⟩

/-- **`{∅, Π, −, ×, ⊎, γ, win}` generates the recursion-free algebra** in
the minimal universe: the match without applies, its selections kept by
their decorrelated tests (`AggQueryIn.exists_selByTest`), its duplicate
eliminations rewritten. -/
theorem rfDiffProdOps_generatesOnRF (sch : Schema) (cnt : SeqAggFunc T) (hcnt : cnt.IsCount) :
    GeneratesOnRF T sch cnt rfDiffProdOps := by
  intro n κ q hq ho _ hi
  obtain ⟨q₂, hu₂, ho₂, hi₂, hs₂, he₂⟩ := exists_rfDec sch hcnt q hq ho hi
  obtain ⟨q₃, hu₃, hi₃, -, ho₃, he₃⟩ := AggQueryIn.exists_rfPass (S := rfDiffProdOps)
    (U := rfDecOps) (by simp [rfDiffProdOps]) (by simp [rfDiffProdOps])
    (Or.inr ⟨by simp [rfDiffProdOps], by simp [rfDiffProdOps]⟩) (by simp [rfDiffProdOps])
    (by simp [rfDiffProdOps]) (by simp [rfDiffProdOps]) (Or.inl (by simp [rfDiffProdOps]))
    (by simp [rfDiffProdOps]) (by simp [rfDiffProdOps])
    (fun k hk => by
      simp only [rfDecOps, Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      simp only [plainOps, basisDD, basisOps, Set.mem_insert_iff, Set.mem_singleton_iff]
      tauto)
    (fun h => absurd h (by simp [rfDecOps])) cnt (Set.mem_singleton cnt) hcnt sch q₂ rfl
    (Or.inl rfl) hu₂ hi₂ ho₂
  refine ⟨_, q₃, ho₃, hu₃, hi₃, AggQueryIn.Extends.of_settles fun D γ _ => ?_⟩
  obtain ⟨hs₃, he₃'⟩ := he₃ D γ (hs₂ D γ)
  exact ⟨hs₃, (he₂ D γ).2.trans he₃'⟩

/-! ## The classification -/

theorem rfSelApplyOps_minimal {S : Set OpKind} (hS : S ⊂ rfSelApplyOps) :
    ¬ ∀ sch : Schema, GeneratesOnRF ℕ sch SeqAggFunc.count S := by
  intro hgen
  have hsub := hS.subset
  have hnot : ∀ k, k ∉ rfSelApplyOps → k ∉ S := fun k hk h => hk (hsub h)
  obtain ⟨he, hp, hu, hg, hw, hs, ha⟩ := required_mem_of_generatesOnRF
    (hnot _ (by simp [rfSelApplyOps])) (hnot _ (by simp [rfSelApplyOps])) hgen
  obtain ⟨x, hx, hxS⟩ := Set.exists_of_ssubset hS
  simp only [rfSelApplyOps, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact hxS he
  · exact hxS hp
  · exact hxS (hs.resolve_right (hnot _ (by simp [rfSelApplyOps])))
  · exact hxS (ha.resolve_left (hnot _ (by simp [rfSelApplyOps])))
  · exact hxS hu
  · exact hxS hg
  · exact hxS hw

